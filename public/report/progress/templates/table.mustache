{{!
    @template local_report_completion_pdf/activities/table

    TODO describe template table

    Example context (json):
    {
    }
}}
<div id="completion-progress-wrapper" class="no-overflow">
    <table id="completion-progress" class="table generaltable flexible table-striped table-hover boxaligncenter" style="text-align:left">
        <thead>
            <tr style="vertical-align:top">
                <th scope="col" class="completion-sortchoice">
                    {{{firstnamelastnameheading}}}
                </th>
                {{#fields}}
                    <th scope="col" class="completion-identifyfield">
                        {{.}}
                    </th>
                {{/fields}}
                {{#formattedactivities}}
                    <th scope="col" class="completion-header">
                        <div class="rotated-text-container">
                            <span class="rotated-text">
                                {{title}}
                            </span>
                        </div>
                    </th>
                {{/formattedactivities}}
            </tr>
            <tr>
                <th scope="col"></th>
                {{#fields}}
                    <th scope="col"></th>
                {{/fields}}
                {{#activityicons}}
                    <th scope="col" class="colheader criterianame criteriaicon" style="text-align: center;">
                        {{#isHtml}}
                            <a href="{{url}}" title="{{title}}">
                            <div class="modicon">
                        {{/isHtml}}
                                {{{icon}}}
                        {{#isHtml}}
                            </div>
                            </a>
                        {{/isHtml}}
                    </th>
                {{/activityicons}}
            </tr>
        </thead>
        <tbody>
            {{#users}}
                <tr>
                    <th scope="row">{{fullname}}</th>
                    {{#extrafields}}
                        <td>{{.}}</td>
                    {{/extrafields}}
                    {{#activityprogress}}
                        <td {{#colcount}}colspan="{{colcount}}"{{/colcount}} class="completion-progresscell">
                            {{#canoverride}}
                            <a href="{{overrideurl}}" class="changecompl" data-changecompl="{{changecompl}}" data-activityname="{{activityname}}" data-userfullname="{{userfullname}}" data-completiontracking="{{completiontracking}}" role="button">
                                {{{describe}}}
                            </a>
                            {{/canoverride}}
                            {{^canoverride}}
                            <span class="symbol" style="font-family: 'zapfdingbats, symbol'">{{{describe}}}</span>
                            {{date}}
                            {{/canoverride}}
                        </td>
                    {{/activityprogress}}
                </tr>
            {{/users}}
        </tbody>
    </table>
</div>
{{#ishtml}}
{{> report_progress/links }}
{{/ishtml}}